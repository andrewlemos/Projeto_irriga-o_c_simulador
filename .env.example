# Porta do servidor (padrão 3456)
PORT=3456

# Caminho absoluto ou relativo do JSON da conta de serviço Firebase
# Preferência 1: variável oficial do Google
# GOOGLE_APPLICATION_CREDENTIALS=./credentials/serviceAccount.json

# Preferência 2: alias do projeto
# FIREBASE_SERVICE_ACCOUNT_PATH=./credentials/serviceAccount.json

# Nome da coleção no Firestore (padrão: telemetry)
# FIRESTORE_COLLECTION=telemetry

# Segundos sem atualização para considerar a estação offline (padrão 300)
# ONLINE_THRESHOLD_SEC=300

# Simulador
# DEVICE_ID=ESP32_Estacao_Campo
# SIM_INTERVAL_MS=60000
